{
  "manifest_version": 3,
  "name": "ScamON AI Website Blocker",
  "version": "1.0.0",
  "description": "Chrome Extension website blocker integrated with ScamON AI FastAPI backend.",
  "permissions": [
    "webNavigation",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://localhost:8001/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {},
  "icons": {
    "128": "icon.png"
  }
}
